{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POE2 Knowledge Card Metadata",
  "type": "object",
  "required": ["id", "module", "status", "confidence", "applies_to", "last_verified", "tags", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^KB-[0-9]{3,}$"},
    "module": {"type": "string"},
    "status": {"enum": ["OFFICIAL", "DATA_VERIFIED", "COMMUNITY_VERIFIED", "INFERENCE", "DISPUTED", "NEEDS_RETEST", "OBSOLETE"]},
    "confidence": {"enum": ["high", "medium-high", "medium", "low"]},
    "applies_to": {"type": "string"},
    "last_verified": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}}
  }
}
